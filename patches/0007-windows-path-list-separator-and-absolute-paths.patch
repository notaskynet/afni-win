diff --git a/src/mrilib.h b/src/mrilib.h
index a25b980..b4d0d4d 100644
--- a/src/mrilib.h
+++ b/src/mrilib.h
@@ -26,6 +26,23 @@
 
 #define COXEMAIL "rwcox@nih.gov"        /* or /dev/null, if you prefer */
 
+/* Separator of directory lists such as PATH or AFNI_ATLAS_PATH, and test
+   for an absolute file name. On Windows lists are separated by ';' (a ':'
+   follows every drive letter) and absolute names may start with "X:/" or
+   "X:\". [afni-win] */
+
+#ifdef _WIN32
+# define THD_PATH_LIST_SEP ';'
+# define THD_IS_ABSPATH(p) ( (p)[0] == '/' ||                              \
+                             ( ( ((p)[0] >= 'A' && (p)[0] <= 'Z') ||        \
+                                 ((p)[0] >= 'a' && (p)[0] <= 'z') ) &&      \
+                               (p)[1] == ':' &&                             \
+                               ((p)[2] == '/' || (p)[2] == '\\') ) )
+#else
+# define THD_PATH_LIST_SEP ':'
+# define THD_IS_ABSPATH(p) ( (p)[0] == '/' )
+#endif
+
 #ifdef  __cplusplus
 extern "C" {                    /* care of Greg Balls    7 Aug 2006 [rickr] */
 #endif
