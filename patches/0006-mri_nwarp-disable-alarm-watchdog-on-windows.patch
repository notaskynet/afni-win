From: afni-win
Subject: [PATCH] mri_nwarp: disable the alarm() watchdog on Windows

Why the compat layer cannot handle this: with OpenMP, 3dQwarp arms
alarm() before the Powell optimizer and its SIGALRM handler longjmp()s out of
the optimizer if a rare gcc OpenMP freeze happens. Windows has no
asynchronous signals: an emulation would have to run the handler on another
thread, and longjmp() across threads is undefined behaviour. MinGW's own
alarm() in libmingwex is a stub that silently does nothing, so the layer
does not declare alarm() and the toolchain links with --wrap=alarm to make
any use fail at link time. Under _WIN32 the watchdog is compiled out; the
optimizer itself is unchanged. Without the watchdog a freeze would hang
instead of being cut short.

diff --git a/src/mri_nwarp.c b/src/mri_nwarp.c
index 9ea7763..ba1c0b9 100644
--- a/src/mri_nwarp.c
+++ b/src/mri_nwarp.c
@@ -8070,7 +8070,7 @@ void IW3D_signal_quit(int sig)
 {
    static volatile int fff=0 ;
    if( fff ) _exit(1) ; else fff = 1 ;   /* stop recursion (shouldn't happen) */
-#ifdef USE_OMP
+#if defined(USE_OMP) && !defined(_WIN32)  /* afni-win: no SIGALRM on Windows */
    (void)alarm(0) ;                      /* disable ALRM signal */
 #endif
    Hquitting = 1 ; Hquitting_sig = sig ; /* set external variables */
@@ -8093,7 +8093,7 @@ void IW3D_signal_quit(int sig)
 
 void IW3D_setup_signal_quit(void){
   signal(SIGQUIT,IW3D_signal_quit);  /* user sent QUIT signal */
-#ifdef USE_OMP
+#if defined(USE_OMP) && !defined(_WIN32)  /* afni-win: no SIGALRM on Windows */
   signal(SIGALRM,IW3D_signal_quit);  /* 21 Apr 2021 -- timeout */
 #endif
   return;
@@ -10843,7 +10843,7 @@ ENTRY("IW3D_improve_warp") ;
 
    if( setjmp(Hquitting_jmp_buf) == 0 ){  /* optimization of Hwarp parameters */
 
-#ifdef USE_OMP
+#if defined(USE_OMP) && !defined(_WIN32)  /* afni-win: no SIGALRM on Windows */
      int asec ;
      asec = (int)rintf(0.0000002f*Hnval*Hnpar*itmax/nthmax) ;
           if( asec <   99 ) asec =   99 ;  /* min num seconds to wait */
@@ -10868,7 +10868,7 @@ ENTRY("IW3D_improve_warp") ;
                                  prad,0.09*prad , itmax , IW3D_scalar_costfun ) ;
      }
 
-#ifdef USE_OMP
+#if defined(USE_OMP) && !defined(_WIN32)  /* afni-win: no SIGALRM on Windows */
      (void)alarm(0) ;   /* cancel alarm signal if we succeeded/returned ! */
 #endif
 
@@ -12241,7 +12241,7 @@ ENTRY("IW3D_improve_warp_plusminus") ;
 
    if( setjmp(Hquitting_jmp_buf) == 0 ){  /* optimization of Hwarp parameters */
 
-#ifdef USE_OMP
+#if defined(USE_OMP) && !defined(_WIN32)  /* afni-win: no SIGALRM on Windows */
      int asec ;
      asec = (int)rintf(0.0000002f*Hnval*Hnpar*itmax/nthmax) ;
           if( asec <   99 ) asec =   99 ;  /* min num seconds to wait */
@@ -12261,7 +12261,7 @@ ENTRY("IW3D_improve_warp_plusminus") ;
      iter = powell_newuoa_con( Hnparmap , parvec,xbot,xtop , 0 ,
                                prad,0.009*prad , itmax , IW3D_scalar_costfun_plusminus ) ;
 
-#ifdef USE_OMP
+#if defined(USE_OMP) && !defined(_WIN32)  /* afni-win: no SIGALRM on Windows */
      (void)alarm(0) ;   /* cancel alarm signal if we succeeded/returned ! */
 #endif
 
